{
  "name": "checkpoint-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/showcase"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx apps/showcase/server/index.ts",
    "build": "npm run build -w @checkpoint/core && npm run build -w @checkpoint/twitch && vite build --config apps/showcase/vite.config.ts && tsc -p apps/showcase/tsconfig.server.json",
    "start": "node --env-file-if-exists=.env apps/showcase/dist-server/apps/showcase/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "example": "tsx examples/signal-panel.ts"
  },
  "dependencies": { "@checkpoint/core": "*", "@checkpoint/twitch": "*", "dotenv": "^17.2.3", "express": "^5.1.0", "react": "^19.3.1", "react-dom": "^19.3.1", "ws": "^8.18.3", "zod": "^4.1.12" },
  "devDependencies": { "@eslint/js": "^9.39.0", "@playwright/test": "^1.56.1", "@types/express": "^5.0.5", "@types/node": "^22.19.0", "@types/react": "^19.2.2", "@types/react-dom": "^19.2.2", "@types/ws": "^8.18.1", "eslint": "^9.39.0", "globals": "^16.5.0", "tsx": "^4.20.6", "typescript": "^5.9.3", "typescript-eslint": "^8.46.2", "vite": "^8.3.5", "vitest": "^5.0.5" }
}
